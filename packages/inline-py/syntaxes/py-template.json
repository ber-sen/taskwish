{
  "scopeName": "inline.python",
  "injectionSelector": "L:source.ts, L:source.js",
  "patterns": [
    {
      "name": "meta.embedded.block.python",
      "begin": "py`",
      "end": "`",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.js" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.js" }
      },
      "patterns": [
        {
          "include": "source.python"
        }
      ]
    }
  ]
}