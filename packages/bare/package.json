{
  "name": "@taskwish/bare",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./cli": {
        "import": "./dist/cli.mjs",
        "require": "./dist/cli.cjs"
      }
    },
    "bin": {
      "bare": "./dist/cli.mjs"
    },
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.ts"
  },
  "version": "0.0.1",
  "description": "Transform TaskWish actor code into bare TypeScript runners",
  "license": "Elastic-2.0",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "source": "./src/cli.ts",
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.cjs",
      "types": "./dist/cli.d.ts"
    }
  },
  "bin": {
    "bare": "./dist/cli.mjs"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "bun test"
  },
  "dependencies": {
    "arktype": "^2.1.29",
    "ts-morph": "^26.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "typescript": "^5.9.2"
  }
}
