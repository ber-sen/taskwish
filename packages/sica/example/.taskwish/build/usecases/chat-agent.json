{
  "$name": "ChatAgent",
  "$schema": "https://taskwish.ai/schema/Actor",
  "on": { "tools": "string[]", "prompt": "string" },
  "steps": [
    {
      "$name": "tools",
      "$schema": "https://taskwish.ai/schema/script",
      "body": "@{tools.filter((tool) => input.tool.includes(tool.name))}"
    },
    {
      "$name": "MarketingAgent",
      "$schema": "https://taskwish.ai/schema/agent.new",
      "instructions": "asdasdadas asdas da",
      "model": "gtp-4",
      "tools": "@{tools}"
    },
    {
      "$name": "MarketingAgent",
      "$schema": "https://taskwish.ai/schema/agent",
      "prompt": "@{input.prompt}"
    }
  ]
}
