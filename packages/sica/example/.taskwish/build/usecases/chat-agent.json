{
  "name": "ChatAgent",
  "type": "usecase",
  "params": [
    {
      "on": { "tools": "string[]", "prompt": "string" },
      "steps": [
        {
          "name": "tools",
          "type": "script::ts",
          "params": {
            "body": "@{tools.filter((tool) => input.tool.includes(tool.name))}"
          }
        },
        {
          "name": "MarketingAgent",
          "type": "agent::new",
          "params": {
            "instructions": "asdasdadas asdas da",
            "model": "gtp-4",
            "tools": "@{tools}"
          }
        },
        {
          "type": "agent::MarketingAgent",
          "params": {
            "prompt": "@{input.prompt}"
          }
        }
      ]
    }
  ]
}
