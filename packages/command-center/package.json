{
  "name": "@taskwish/command-center",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.1",
  "description": "Command Center UI for Taskwish nodes",
  "license": "Elastic-2.0",
  "author": "Bersen Pajaziti",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "source": "./src/types.ts",
      "types": "./dist/index.d.ts"
    },
    "./index.html": {
      "source": "./src/index.html",
      "default": "./src/index.html"
    }
  },
  "taskwish": {
    "htmlSource": "./src/index.html"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "scripts": {
    "build": "bun ../../scripts/build-package.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^2.5.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/bun": "^1.3.12",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
