{
  "(Actor)": "ChatActor",
  "actions": [
    {
      "on": { "tools": "string[]", "prompt": "string" },
      "run": [
        {
          "(Step)": "tools",
          "run": "@{tools.filter((tool) => input.tool.includes(tool.name))}"
        },
        {
          "(If)": "@{2 > 3}",
          "run": [
            {
              "(Agent)": "MarketingAgent",
              "instructions": "asdasdadas asdas da",
              "model": "gtp-4",
              "tools": "@{tools}"
            },
            {
              "(Emit)": "Send message",
              "from": "string",
              "subject": "string"
            },
            {
              "(MarketingAgent)": "end",
              "prompt": "@{input.prompt}"
            }
          ]
        }
      ]
    }
  ]
}
