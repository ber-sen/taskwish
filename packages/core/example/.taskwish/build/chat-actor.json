{
  "$": "Actor",
  "=": "SwiftWrangler",
  "color": "#c42e5b",
  "role": [
    {
      "on": "ChatMessage",
      "run": [
        {
          "$": "Slack.sendMessage",
          "=": "senm",
          "channel": "#general"
        },
        {
          "$": "generateText",
          "=": "gent",
          "model": "gpt-3.5-turbo-1106",
          "prompt": "@{senm.text}"
        }
      ]
    }
  ]
}