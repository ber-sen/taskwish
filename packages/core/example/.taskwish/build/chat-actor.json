{
  "(type)": "Actor",
  "(name)": "ChatActor",

  "behaviors": [
    {
      "(on)": "command",
      "(name)": "Chat",

      "input": {
        "tools": "string[]",
        "prompt": "string"
      },
      "run": [
        {
          "(type)": "Step",
          "(name)": "Selected Tools",

          "run": "@{tools.filter((tool) => input.tool.includes(tool.name))}"
        },
        {
          "(if)": "@{3 > 2}",

          "run": [
            {
              "(type)": "Agent",
              "(name)": "Marketing Agent",

              "instructions": "asdasdadas asdas da",
              "model": "gtp-4",
              "tools": "@{selectedTools}"
            },
            {
              "(type)": "MarketingAgent",
              "(name)": "End",

              "prompt": "@{input.prompt}"
            }
          ]
        }
      ]
    }
  ]
}
