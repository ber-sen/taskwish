{
  "[actor]": "ChatActor",
  "behaviors": [
    {
      "on": { "tools": "string[]", "prompt": "string" },
      "run": [
        {
          "[script]": "tools",
          "run": "@{tools.filter((tool) => input.tool.includes(tool.name))}"
        },
        { "[if]": "@{2 > 3}" },
        {
          "[Agent::new]": "MarketingAgent",
          "instructions": "asdasdadas asdas da",
          "model": "gtp-4",
          "tools": "@{tools}"
        },
        {
          "[MarketingAgent]": "end",
          "prompt": "@{input.prompt}"
        },
        { "[end]": "[if]" }
      ]
    }
  ]
}
